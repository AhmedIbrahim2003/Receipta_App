<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Debug-only: allow plain http:// so the app can reach the local dev
         backend (see Env.apiBaseUrl / env.json). Android blocks cleartext
         traffic by default since API 28. Not present in the release
         manifest, so release builds still require https. -->
    <application android:usesCleartextTraffic="true" />
</manifest>
